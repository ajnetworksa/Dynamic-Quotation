
# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
OPENROUTER_API_KEY=""

# PORT: The port number the server will listen on.
# Default is 3000 (matches docker-compose.yml). Change this if port 3000 is occupied.
PORT=3000

# ADMIN_INITIAL_PASSWORD: password for the first "admin" account on a brand-new database (10+ characters).
# Leave empty to get a random one printed once in the server log. Ignored once an admin exists.
ADMIN_INITIAL_PASSWORD=""

# DB_PATH: where the SQLite database lives. Default: ./quotes.db next to server.ts.
# DB_PATH="/app/data/quotes.db"

# ALLOW_SELF_UPDATE: set to true to enable Settings > System Update (git pull + npm install + build on the server).
# Off by default; prefer deploying through your normal pipeline.
# ALLOW_SELF_UPDATE=false
